# Build output
/bin/
*.wasm
web/dist/

# Dependencies and caches
web/node_modules/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Corpus data: never commit. Download scripts write here.
/data/corpora/
/data/raw/
/data/processed/
*.conllu
*.atf

# TTS: never commit audio, model weights or training runs.
/runs/
/.ort/
*.onnx
*.onnx.data
*.pt
*.pth
*.ckpt
*.safetensors
*.wav
*.mp3
*.flac
*.ogg
mlflow.db
mlruns/
# Synthesized evaluation samples (listen locally; only the input list is tracked).
/eval/samples/*
!/eval/samples/README.md

# Local env / editors / OS
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
