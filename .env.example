# Copy to .env (git-ignored) for ./start.sh and docker compose. Without these,
# both use ./data/corpora and ./runs/checkpoints in the repository (and compose
# ./.ollama/models). Paths may contain spaces; no quotes needed.
#
# ./start.sh: a shared model drive. Datasets and checkpoints then default to
# $MODELS_ROOT/projects/nabu/..., Ollama models to $MODELS_ROOT/ollama, and the
# script refuses to start when the drive is not mounted.
MODELS_ROOT=/Volumes/Models
# docker compose: host paths bind-mounted into the containers (compose does not
# derive them from MODELS_ROOT, so spell them out):
NABU_DATA_DIR=/Volumes/Models/projects/nabu/datasets
NABU_CHECKPOINT_DIR=/Volumes/Models/projects/nabu/checkpoints
OLLAMA_MODELS=/Volumes/Models/ollama
